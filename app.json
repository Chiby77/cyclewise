{
  "expo": {
    "name": "CycleWise",
    "slug": "cyclewise-mobile",
    "scheme": "cyclewise",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bluewave.cyclewise",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow CycleWise to use Face ID to protect your health data.",
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": false,
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {}
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.bluewave.cyclewise",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow CycleWise to use Face ID to protect your health data."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F06292"
        }
      ],
      [
        "react-native-widget-extension",
        {
          "frequentUpdates": false
        }
      ],
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "CycleWiseWidgets",
                  "bundleIdentifier": "com.bluewave.cyclewise.CycleWiseWidgets",
                  "entitlements": {}
                }
              ]
            }
          }
        },
        "projectId": "7ea71c67-fdb0-4a43-ab29-f614d00b4930"
      }
    },
    "owner": "tino_chiby"
  }
}
