{
  "expo": {
    "name": "CycleWise",
    "slug": "cyclewise-mobile",
    "scheme": "cyclewise",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bluewave.cyclewise",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow CycleWise to use Face ID to protect your health data."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.bluewave.cyclewise",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow CycleWise to use Face ID to protect your health data."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F06292"
        }
      ],
      "@sentry/react-native/expo",
      [
        "react-native-widget-extension",
        {
          "frequentUpdates": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "CycleWiseWidgets",
                  "bundleIdentifier": "com.bluewave.cyclewise.CycleWiseWidgets",
                  "entitlements": {}
                }
              ]
            }
          }
        },
        "projectId": "c5090f00-e64c-4003-ad90-cfe360db80ff"
      }
    },
    "owner": "intellix_coder"
  }
}
